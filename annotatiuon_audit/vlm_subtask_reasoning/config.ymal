# 输入：每个episode目录下的完整文本标注，不读取图像。
input:
  root: /mnt/data/chachaxu/dataset/robodojo/robodojo_stage4_thinking_fps2_20261025_164250
  glob: '*/final.json' # 相对于root的文件匹配规则
  selection_file: null # 可选JSON数组，值为episode目录名
output:
  root: /mnt/workspace/vlm_subtask_reasoning/outputs/robodojo_reasoning_v1 # 不得与输入目录重叠
runtime:
  episode_batchsize: 32 # 并发episode数；一个episode一次完整文本请求
  attempts: 3 # 每次运行每个episode的最大请求尝试数，含结构校验失败
  retry_delay_sec: 3 # 重试等待秒数
model:
  credential_config: /mnt/workspace/robocoin_annotation_all4_control/config_full_duration_000_010s_1013.yaml # 仅复用model内连接参数
  base_url: null # 非空时覆盖凭据配置
  api_key: null # 建议使用环境变量，不把密钥写入配置
  name: null # 模型名；null时沿用凭据配置的model字段
  base_url_env: SUBTASK_REASONING_BASE_URL # 环境变量优先
  api_key_env: SUBTASK_REASONING_API_KEY
  name_env: SUBTASK_REASONING_MODEL
  thinking: true # 通过chat_template_kwargs.enable_thinking传递
  temperature: 0.0 # 采样温度
  max_tokens: 8192 # 模型最大输出token数
  timeout_sec: 1800 # 单次请求超时秒数
